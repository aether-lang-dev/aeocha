// Code under test (CUT) for the mutation-testing demo. This is the same
// `calc` used in the top-level Aeocha README's Quick Start — the point
// of mutation testing is to check how well that suite tests this code.
exports ( add, abs )

add(a: int, b: int) -> int { return a + b }

abs(n: int) -> int {
    if n < 0 { return 0 - n } else { return n }
}
