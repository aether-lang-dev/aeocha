// Aeocha test for the regression fixture. Deliberately tests `add` but
// NOT `mul`, so the mutation run yields exactly one killed (ADD->SUB)
// and one survivor (MUL->DIV). The harness pins those numbers.
import aeocha
import sut

extern exit(code: int)

main() {
    fw = aeocha.init()
    aeocha.describe(fw, "sut") {
        aeocha.it("add is tested") callback {
            aeocha.assert_eq(sut.add(2, 3), 5, "2+3")
        }
        // mul is intentionally NOT tested -> MUL->DIV survives.
    }
    aeocha.run_summary(fw)
    exit(0)
}
