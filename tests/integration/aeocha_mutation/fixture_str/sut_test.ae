import aeocha
import sut
extern exit(code: int)
main() {
    fw = aeocha.init()
    aeocha.describe(fw, "sut") {
        // Only name() is pinned. motto() and help() are unchecked, so
        // blanking their strings survives.
        aeocha.it("name") callback { aeocha.assert_str_eq(sut.name(), "alice", "name") }
    }
    aeocha.run_summary(fw)
    exit(0)
}
