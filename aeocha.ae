// Aeocha — BDD-style test framework for Aether
// MIT License — Copyright (c) 2025 Aether Programming Language Contributors
//
// Spec framework with describe / it / before_each / after_each, built
// on Aether's trailing blocks + closures + the _ctx builder
// context-injection pattern.
//
// Usage:
//
//     import aeocha
//
//     main() {
//         fw = aeocha.init()
//         aeocha.describe(fw, "Counter") {
//             aeocha.before_each() callback {
//                 reset()
//             }
//             aeocha.it("starts at zero") callback {
//                 aeocha.assert_eq(count(), 0, "initial")
//             }
//             aeocha.it("increments") callback {
//                 increment()
//                 aeocha.assert_eq(count(), 1, "after one inc")
//             }
//         }
//         aeocha.run_summary(fw)
//     }
//
// Run with: aeb test  (or `ae run my_test.ae` if you prefer no harness).
// Exit code 0 = all passed, 1 = failures.
//
// fw threading (mostly removed): the framework counters live in a `fw`
// context map, but matchers no longer take it as a parameter. init()
// stores the context in a module-level `current_fw` cell (Aether gained
// mutable module-level globals + module-var-shared-across-imports), and
// every assert_*/expect_*/fail reads it. Only the *structural* calls
// still take `fw`: the top-level `describe(fw, ...)` (no enclosing block
// to auto-inject a context) and `run_summary(fw)`. Tradeoff: one
// framework per process — a second init() rebinds current_fw. Nested
// describe/it/hooks omit the arg entirely (Aether auto-injects the
// suite `_ctx`).
//
// `after_each` is the survivor; bare `after` was deleted because it
// collides with Aether's actor-receive `after N -> { ... }` timeout
// syntax (TODO item 2).

import std.list
import std.map
import std.string
import std.strbuilder
import std.http
import std.http.client
import std.os
import std.regex
import std.ipc
import std.net

exports (
    init,
    describe, it, it_within,
    before_each, after_each,
    fail, assert_true, assert_false,
    assert_eq, assert_str_eq, assert_not_eq, assert_gt,
    assert_contains, assert_null, assert_not_null,
    // Integration-shape matchers — process surface
    expect_exit, expect_no_spawn_error,
    expect_stdout_contains,
    expect_stdout_line_field,
    expect_stdout_line_after,
    expect_stdout_line_count,
    expect_stdout_matches,
    expect_stdout_matches_regex,
    // Child stderr matchers (consume os.run_full's 2nd slot)
    expect_stderr_contains, expect_stderr_empty,
    // Timing-budget matcher (caller-measured monotonic-ns span vs a
    // Duration literal)
    expect_elapsed_under,
    // Integration-shape matchers — HTTP surface (low-level: caller
    // owns the resp lifecycle)
    expect_http_status, expect_http_no_error,
    expect_http_body_contains, expect_http_body_eq, expect_http_header,
    expect_http_body_json_field,
    // High-level GET-and-assert matchers (do the request lifecycle for
    // the caller — one line per asserted HTTP response). Honour a
    // preceding within()/without() floating modifier for retry.
    expect_http_get_status,
    expect_http_get_body_eq, expect_http_get_body_contains,
    // Floating-modifier retry scoping (FluentSelenium within/without):
    // set an ambient budget the next GET matcher polls against.
    within, within_poll, without, without_poll,
    // Generic poll-until form of the floating modifier (within(5s);
    // eventually(pred, msg)). Unblocked by aether #940/#943.
    eventually,
    // Fluent assertion facade — subject-first, chainable (ae 0.328+:
    // needs cross-module UFCS #934 + module-var-across-import #937, both
    // fixed). expect_int/expect_str start a chain that reads the
    // framework from an ambient cell, so no `fw` leaks into the chain.
    expect_int, expect_str, not_,
    IntSubject, StrSubject,
    to_equal, to_be_gt, to_be_lt, to_be_truthy, to_be_falsy,
    to_equal_str, to_contain, to_start_with,
    // Fluent escape hatch — drop into a one-off predicate mid-chain.
    satisfies, satisfies_str,
    // Collection matchers (std.list of strings)
    expect_list_size, expect_list_empty, expect_list_has_str,
    run_summary
)

// Ambient "current framework" cell. EVERY matcher reads it — the flat
// assert_*/expect_* family and the fluent chain alike — so no `fw`
// argument threads through assertions (3a). init() sets it; fail() reads
// it. Declared `ptr` (not an inferred int — aether #929) so the 64-bit
// pointer survives, and relies on module-var state being shared across
// the import boundary (aether #937, fixed in 0.328). Single-framework
// per process: a second init() overwrites it — the documented tradeoff
// for ambient state. To drive two frameworks at once you'd need the
// old fw-threaded API back; that's the price of the cleaner signatures.
var current_fw: ptr = null

// Floating-modifier retry budget (the FluentSelenium within()/without()
// pattern). within(5s) sets an ambient budget that the NEXT retryable
// matcher (the expect_http_get_* family) consults, then auto-reverts —
// "if you don't do within there is no waiting; it doesn't last beyond
// the operation to its right." Positional, one-shot, self-reverting:
// not a block, binds no name, attaches to the next operation like an
// adverb to a verb. Declared `long` (ns) — an inferred int would
// truncate a 64-bit ns budget (aether #929). `without_mode` flips the
// poll sense: within waits for success, without waits for the condition
// to stop holding. poll_ns is the inter-attempt sleep.
var retry_budget_ns: long = 0
var retry_poll_ns: long = 0
var retry_without: int = 0

// within(budget) — wait up to `budget` for the next retryable matcher to
// pass, polling every 50ms. without(budget) — wait up to `budget` for it
// to STOP passing (poll-until-absent). within_poll/without_poll set an
// explicit poll interval. All four are one-shot: the next retryable
// matcher consumes and clears the budget.
within(budget: Duration)        { retry_budget_ns = budget.ns  retry_poll_ns = 50000000  retry_without = 0 }
within_poll(budget: Duration, poll: Duration) { retry_budget_ns = budget.ns  retry_poll_ns = poll.ns  retry_without = 0 }
without(budget: Duration)       { retry_budget_ns = budget.ns  retry_poll_ns = 50000000  retry_without = 1 }
without_poll(budget: Duration, poll: Duration) { retry_budget_ns = budget.ns  retry_poll_ns = poll.ns  retry_without = 1 }

// Snapshot the ambient retry budget and FULLY reset the retry state for
// the next matcher. Returns the budget (0 = no retry). The caller must
// read retry_poll_ns / retry_without BEFORE calling this (they're reset
// here too). Resetting all three — not just the budget — is essential:
// otherwise a no-within matcher after a without() would inherit the
// stale without flag and invert its sense. One-shot means one-shot for
// every field of the modifier.
_take_retry_budget() -> long {
    b = retry_budget_ns
    retry_budget_ns = 0
    retry_poll_ns = 0
    retry_without = 0
    return b
}

// ---------------------------------------------------------------------------
// Framework context — counters and depth, threaded through every call
// ---------------------------------------------------------------------------

// Build a fresh framework context. Holds the test-run counters
// (passed / failed) and the indentation depth (depth) as refs. The
// caller threads the returned ptr through every aeocha.* call; the
// suite contexts created by describe() carry it as an inner field.
//
// Also stamps the run-start timestamp + a per-it() record list +
// a "current_it" pointer-cell. These exist whether or not a parent
// IPC channel is present — the cost is bounded (a list of small
// maps, one per it()) and they're used by run_summary's structured
// report when invoked under a parent (e.g. aeb's driver_test). When
// invoked without a parent (`ae run foo.ae` from a terminal),
// run_summary doesn't read them and they get freed at exit.
init() -> ptr {
    fw = map.new()
    map.put_raw(fw, "passed", ref(0))
    map.put_raw(fw, "failed", ref(0))
    map.put_raw(fw, "depth",  ref(0))
    // Per-it() telemetry (for the structured aeb-report path).
    // "current_it" stores the in-flight it-record map directly (or null
    // when no it() is running) — bypasses ref cells because ref_get
    // truncates pointers to 32 bits in codegen. "t_start_ns_str" is a
    // decimal-string of the monotonic-clock start so we keep all 64
    // bits; parsed back via string.get_long in run_summary. Monotonic
    // (os.now_monotonic_ns), not wall-clock (clock_ns): the run-total
    // duration is a delta, and a wall-clock jump (NTP step, DST) mid-run
    // would otherwise corrupt it. Only deltas are meaningful here.
    map.put_raw(fw, "its", list.new())
    map.put_raw(fw, "current_it", null)
    map.put_raw(fw, "t_start_ns_str", "${os.now_monotonic_ns()}")
    // Make this the ambient framework for the fluent facade.
    current_fw = fw
    return fw
}

// ---------------------------------------------------------------------------
// Suite context — what describe() returns for _ctx injection
//
// Each suite holds:
//   "name"     — string label for printing
//   "befores"  — list of boxed closures (run before each it())
//   "afters"   — list of boxed closures (run after each it())
//   "fw"       — back-pointer to the framework context (so it / assertions
//                inside the trailing block can find passed/failed/depth)
// ---------------------------------------------------------------------------

_suite_new(name: string, fw: ptr, parent: ptr) -> ptr {
    s = map.new()
    map.put_raw(s, "name", name)
    map.put_raw(s, "befores", list.new())
    map.put_raw(s, "afters",  list.new())
    map.put_raw(s, "fw",      fw)
    map.put_raw(s, "parent",  parent)
    return s
}

// Return the framework context for a given _ctx (which may itself be
// the framework context if the call is at top level, or a suite
// context if the call is inside a describe trailing block).
_fw_of(ctx: ptr) -> ptr {
    if map.has(ctx, "fw") == 1 {
        f = map.get_raw(ctx, "fw")
        return f
    }
    return ctx
}

// ---------------------------------------------------------------------------
// describe() — top-level grouping. Trailing-block-driven; the block
// receives the suite context as _ctx so before_each/after_each/it
// register against it.
// ---------------------------------------------------------------------------

describe(_ctx: ptr, description: string) -> ptr {
    fw = _fw_of(_ctx)
    depth_ref = map.get_raw(fw, "depth")
    d = ref_get(depth_ref)
    for (i = 0; i < d; i++) { print("  ") }
    println(description)
    ref_set(depth_ref, d + 1)

    parent = null
    if map.has(_ctx, "fw") == 1 {
        parent = _ctx
    }
    return _suite_new(description, fw, parent)
}

// ---------------------------------------------------------------------------
// before_each / after_each — register hooks against the surrounding
// describe's suite context.
// ---------------------------------------------------------------------------

before_each(_ctx: ptr, setup: fn) {
    bl = map.get_raw(_ctx, "befores")
    list.add(bl, box_closure(setup))
}

after_each(_ctx: ptr, teardown: fn) {
    al = map.get_raw(_ctx, "afters")
    list.add(al, box_closure(teardown))
}

// Helper to run all before_each hooks for a suite and its ancestors,
// from outer-most to inner-most.
_run_befores(s: ptr) {
    p = map.get_raw(s, "parent")
    if p != null {
        _run_befores(p)
    }
    befores = map.get_raw(s, "befores")
    n = list.size(befores)
    for (i = 0; i < n; i++) {
        bh = list.get_raw(befores, i)
        call(unbox_closure(bh))
    }
}

// Helper to run all after_each hooks for a suite and its ancestors,
// from inner-most to outer-most.
_run_afters(s: ptr) {
    afters = map.get_raw(s, "afters")
    n = list.size(afters)
    for (i = 0; i < n; i++) {
        ah = list.get_raw(afters, i)
        call(unbox_closure(ah))
    }
    p = map.get_raw(s, "parent")
    if p != null {
        _run_afters(p)
    }
}

// ---------------------------------------------------------------------------
// it() — one test case. Runs all befores, then the test, then all
// afters. Failure is communicated by assertions inside the test body
// bumping the framework's failed counter; we snapshot the count
// before and after to know whether anything failed in this run.
// ---------------------------------------------------------------------------

it(_ctx: ptr, description: string, test_fn: fn) {
    // budget_ns 0 = no time budget (plain it()).
    _it_impl(_ctx, description, test_fn, 0)
}

// it_within(_ctx, description, budget, test_fn) — an it() that also
// fails if the test body takes longer than `budget`. The budget check
// is layered on top of the normal assertion-based pass/fail: a body
// that asserts cleanly but runs over budget still goes red. Uses the
// same monotonic elapsed the report already records, so there's no
// extra measurement. `budget` is a Duration literal (`50ms`, `2s`).
it_within(_ctx: ptr, description: string, budget: Duration, test_fn: fn) {
    _it_impl(_ctx, description, test_fn, budget.ns)
}

// Shared it() body. budget_ns > 0 adds a "ran within budget" check
// after the body completes; 0 disables it.
_it_impl(_ctx: ptr, description: string, test_fn: fn, budget_ns: long) {
    fw = _fw_of(_ctx)
    passed_ref = map.get_raw(fw, "passed")
    failed_ref = map.get_raw(fw, "failed")
    depth_ref = map.get_raw(fw, "depth")

    // Run before hooks (inherited outer-to-inner)
    _run_befores(_ctx)

    // Build a per-it record map and stash it as the "current" so
    // fail() can capture the first failure message into it. The
    // record gets appended to fw.its at the end of this call,
    // regardless of pass/fail, with status + duration filled in.
    // Pointer-valued slots (current_it, the it-record map, the it
    // record's "duration_ms_str") are stored via map.put_raw rather
    // than through ref() cells because ref_get truncates to 32 bits.
    it_rec = map.new()
    map.put_raw(it_rec, "name", description)
    its_list = map.get_raw(fw, "its")
    map.put_raw(fw, "current_it", it_rec)

    // Monotonic clock for the elapsed span — only the delta matters,
    // and clock_ns() (wall clock) could jump under NTP/DST mid-test.
    t_start_ns = os.now_monotonic_ns()
    old_failed = ref_get(failed_ref)
    call(test_fn)
    t_end_ns = os.now_monotonic_ns()
    elapsed_ns = t_end_ns - t_start_ns

    // Time-budget check (it_within). Reported via fail() while
    // current_it is still set, so it counts against this it() and its
    // message is captured in the record. Done before tearing down
    // current_it below.
    if budget_ns > 0 {
        if elapsed_ns >= budget_ns {
            elapsed_ms = elapsed_ns / 1000000
            budget_ms = budget_ns / 1000000
            fail("${description} — exceeded time budget: ${elapsed_ms}ms >= ${budget_ms}ms")
        }
    }

    // Tear down "current" pointer before any after-hooks so a hook
    // failure doesn't get mis-attributed to this it's record.
    map.put_raw(fw, "current_it", null)

    // Indent + result line
    d = ref_get(depth_ref)
    for (i = 0; i < d; i++) { print("  ") }
    is_fail = 0
    if ref_get(failed_ref) == old_failed {
        print("\x1b[32m  ✓\x1b[0m ${description}\n")
        ref_set(passed_ref, ref_get(passed_ref) + 1)
    } else {
        print("\x1b[31m  ✗\x1b[0m ${description}\n")
        is_fail = 1
    }

    // Stamp status + duration on the record.
    if is_fail == 1 {
        map.put_raw(it_rec, "status", "FAIL")
    } else {
        map.put_raw(it_rec, "status", "PASS")
    }
    // Store the FULL ns duration (decimal string to keep all 64 bits,
    // like t_start_ns_str). The report derives ms from this when it
    // needs the v1-compat field; rows carry the ns directly so fast
    // tests don't all round to 0ms (4e).
    map.put_raw(it_rec, "duration_ns_str", "${elapsed_ns}")
    list.add(its_list, it_rec)

    // Run after hooks (inherited inner-to-outer)
    _run_afters(_ctx)
}

// ---------------------------------------------------------------------------
// Assertions — each reports via fail(), which bumps the ambient
// framework's failed counter (current_fw) when the check doesn't hold.
// No `fw` parameter (3a). They print the failure inline and continue
// (no exit), letting the surrounding it() see the bumped counter and
// mark the case red.
// ---------------------------------------------------------------------------

// fail(msg) — record a failure against the ambient framework
// (current_fw, set by init()). No `fw` parameter since 3a: every
// matcher and user assertion reports through here, reading the ambient
// cell rather than threading `fw`. Single-framework-per-process is the
// documented tradeoff (a second init() rebinds current_fw).
fail(msg: string) {
    failed_ref = map.get_raw(current_fw, "failed")
    print("\x1b[31m      FAIL: ${msg}\x1b[0m\n")
    ref_set(failed_ref, ref_get(failed_ref) + 1)

    // Capture first failure message into the current it() record
    // (if any). The structured aeb-report writes one message per
    // failed it; subsequent fails within the same it are visible
    // in the human output but only the first is recorded — keeps
    // the report bounded and matches "what made this it red"
    // semantics. current_it is stored directly (not via ref()) to
    // preserve the full pointer width.
    cur = map.get_raw(current_fw, "current_it")
    if cur != null {
        if map.has(cur, "failure_message") == 0 {
            map.put_raw(cur, "failure_message", msg)
        }
    }
}

assert_true(condition: int, msg: string) {
    if condition == 0 {
        fail("${msg} — expected true")
    }
}

assert_false(condition: int, msg: string) {
    if condition != 0 {
        fail("${msg} — expected false")
    }
}

assert_eq(actual: int, expected: int, msg: string) {
    if actual != expected {
        fail("${msg} — expected ${expected}, got ${actual}")
    }
}

assert_str_eq(actual: string, expected: string, msg: string) {
    if string.equals(actual, expected) == 0 {
        fail("${msg} — expected '${expected}', got '${actual}'")
    }
}

assert_not_eq(actual: int, expected: int, msg: string) {
    if actual == expected {
        fail("${msg} — expected not ${expected}")
    }
}

assert_gt(actual: int, expected: int, msg: string) {
    if actual <= expected {
        fail("${msg} — expected > ${expected}, got ${actual}")
    }
}

assert_contains(haystack: string, needle: string, msg: string) {
    if string.contains(haystack, needle) == 0 {
        fail("${msg} — '${haystack}' does not contain '${needle}'")
    }
}

assert_null(value: ptr, msg: string) {
    if value != 0 {
        fail("${msg} — expected null")
    }
}

assert_not_null(value: ptr, msg: string) {
    if value == 0 {
        fail("${msg} — expected non-null")
    }
}

// ---------------------------------------------------------------------------
// Integration-shape matchers
//
// Built on top of the assert_* primitives above, these absorb the
// bash-shaped "spawn / capture / awk-and-compare" idiom into a single
// Aether call. Two flavours:
//
//   - Process matchers consume a `(stdout, exit, stderr)` triple from
//     `os.run_capture(prog, argv, env)`. The triple is always passed
//     destructured (Aether tuples don't pass around as a single value).
//
//   - HTTP matchers consume the response handle returned by
//     `http.get` / `http.post` / `client.send_request`. A single
//     `resp: ptr` arg works for both v1 and v2 responses (same C
//     struct underneath).
//
// Each matcher takes (..., msg) and signals failure by calling
// `fail(...)` — same shape as the `assert_*` primitives. None of
// them allocate persistent state; intermediate `string_split` arrays
// are freed before return.
// ---------------------------------------------------------------------------

// expect_exit(exit_code, want, msg) — child exited with the
// expected status. The most common shape: caller writes
//   out, exit, err = os.run_capture(prog, argv, null)
//   aeocha.expect_exit(exit, 0, "ran cleanly")
expect_exit(exit_code: int, want: int, msg: string) {
    if exit_code != want {
        fail("${msg} — expected exit ${want}, got ${exit_code}")
    }
}

// expect_no_spawn_error(err, msg) — `os.run_capture`'s third
// slot is non-empty only when fork/exec itself couldn't run (binary
// not found, EACCES, etc.). Distinct from "ran but exited non-zero",
// which is exit_code != 0 and err == "". Use this to assert "the
// child actually started" before asserting on its output.
expect_no_spawn_error(err: string, msg: string) {
    if string.equals(err, "") == 0 {
        fail("${msg} — spawn error: '${err}'")
    }
}

// expect_stdout_contains(out, needle, msg) — captured stdout
// has the substring somewhere. Sibling of assert_contains with a
// slot-shaped signature for the run_capture tuple. Param is named
// `out` not `stdout` because Windows MinGW <stdio.h> defines
// `stdout` as a preprocessor macro (`(__acrt_iob_func(1))`) and a
// param named `stdout` gets rewritten mid-declaration. Same
// rationale for the other three expect_stdout_* matchers below.
expect_stdout_contains(out: string, needle: string, msg: string) {
    if string.contains(out, needle) == 0 {
        fail("${msg} — stdout does not contain '${needle}'")
    }
}

// Child stderr matchers. The stderr capture these need now exists:
// `os.run_full(prog, argv, env, stdin) -> (stdout, stderr, exit, err)`
// captures the child's two streams SEPARATELY (no pipe-buffer
// deadlock), unlike `os.run_capture` whose third slot is the
// spawn-error string, not child stderr. Callers feed the 2nd tuple
// slot to these matchers:
//   out, err, exit, spawn_err = os.run_full(prog, argv, null, "")
//   aeocha.expect_no_spawn_error(spawn_err, "started")
//   aeocha.expect_stderr_contains(err, "deprecated", "warned")
// (param `err` is the captured child stderr stream — distinct from
// the spawn-error slot that expect_no_spawn_error consumes.)

// expect_stderr_contains(err, needle, msg) — captured child
// stderr has the substring somewhere. The stderr twin of
// expect_stdout_contains; consumes os.run_full's 2nd slot.
expect_stderr_contains(err: string, needle: string, msg: string) {
    if string.contains(err, needle) == 0 {
        fail("${msg} — stderr does not contain '${needle}'")
    }
}

// expect_stderr_empty(err, msg) — child wrote nothing to stderr.
// Asserts a clean run with no warnings/diagnostics on fd 2. Consumes
// os.run_full's 2nd slot.
expect_stderr_empty(err: string, msg: string) {
    if string.equals(err, "") == 0 {
        fail("${msg} — stderr not empty: '${err}'")
    }
}

// expect_stdout_line_count(out, want, msg) — stdout has
// exactly `want` newline-separated lines. Trailing-newline aware:
// `"a\nb\n"` counts as 2 lines, not 3. (param `out`, not `stdout` —
// see expect_stdout_contains for the Windows-MinGW reason.)
expect_stdout_line_count(out: string, want: int, msg: string) {
    arr = string.split(out, "\n")
    n = string.array_size(arr)
    // string_split("a\nb\n", "\n") produces ["a", "b", ""] — drop
    // the trailing empty when the last byte is a newline.
    sl = string.length(out)
    if sl > 0 {
        if string.char_at(out, sl - 1) == 10 {
            n = n - 1
        }
    }
    string.array_free(arr)
    if n != want {
        fail("${msg} — expected ${want} lines, got ${n}")
    }
}

// expect_stdout_line_field(out, prefix, n, want, msg) —
// finds the first line starting with `prefix`, tokenises on runs
// of whitespace (spaces and tabs), and compares field index `n` to
// `want`. This is the matcher that absorbs the most bash:
// `rev=$(echo "$out" | awk '/^Revision:/{print $2}')` collapses to
// `expect_stdout_line_field(fw, out, "Revision:", 1, "3", ...)`.
//
// Whitespace handling matches awk's default: any run of spaces or
// tabs separates tokens, leading whitespace is skipped, and empty
// tokens never appear in the field array. So a column-aligned
// `Revision:    3` line tokenises to `["Revision:", "3"]` and
// field 1 is `"3"` regardless of how many spaces actually separate
// them.
//
// Indexing is 0-based on tokens — n=0 names the prefix token,
// n=1 the next non-blank token. (awk's `$1`/`$2` are 1-based;
// Aeocha is 0-based to match the rest of the matcher fleet.)
//
// Limitations (deliberate — porter scope):
//   - First match wins. Use a more specific prefix if multiple
//     lines share a prefix and you want the second one.
//   - Whitespace = ASCII space + tab. Newlines have already been
//     consumed by the per-line split.
//
// (Param `out`, not `stdout` — Windows MinGW reason.)
expect_stdout_line_field(out: string, prefix: string,
                          n: int, want: string, msg: string) {
    lines = string.split(out, "\n")
    line_count = string.array_size(lines)
    found = 0
    actual = ""
    i = 0
    while i < line_count {
        line_ptr = string.array_get(lines, i)
        if string.starts_with(line_ptr, prefix) == 1 {
            // Tokenise on runs of whitespace (space=32, tab=9). Walk
            // the line collecting non-whitespace spans into an
            // imaginary array indexed by `tok_idx`; when tok_idx
            // reaches `n` capture the span.
            // char_at_n over char_at: line_len is already cached, so
            // the length-aware accessor skips the per-call strlen
            // char_at would pay on every byte of the line walk.
            line_len = string.length(line_ptr)
            tok_idx = 0
            p = 0
            while p < line_len {
                c = string.char_at_n(line_ptr, line_len, p)
                if c == 32 || c == 9 {
                    p = p + 1
                } else {
                    start = p
                    scanning = 1
                    while scanning == 1 {
                        if p >= line_len {
                            scanning = 0
                        } else {
                            c2 = string.char_at_n(line_ptr, line_len, p)
                            if c2 == 32 || c2 == 9 {
                                scanning = 0
                            } else {
                                p = p + 1
                            }
                        }
                    }
                    if tok_idx == n {
                        actual = string.substring(line_ptr, start, p)
                        found = 1
                        p = line_len
                    }
                    tok_idx = tok_idx + 1
                }
            }
            i = line_count
        } else {
            i = i + 1
        }
    }
    string.array_free(lines)
    if found == 0 {
        fail("${msg} — no line starts with '${prefix}' or field ${n} missing")
    } else {
        if string.equals(actual, want) == 0 {
            fail("${msg} — expected '${want}', got '${actual}'")
        }
    }
}

// expect_stdout_line_after(out, prefix, want, msg) — finds
// the first line starting with `prefix`, takes everything after
// the prefix, trims leading and trailing whitespace, and compares
// against `want`. Absorbs the bash idiom
//   log=$(echo "$out" | sed -n 's/^Log: *//p')
// which is common in svn/git-style key-value output where the
// value can contain embedded whitespace and a single-token field
// match wouldn't capture it correctly.
//
// `expect_stdout_line_field(out, "Log:", 1, ...)` would only see
// the first whitespace-separated token after the prefix; this
// matcher captures the entire post-prefix remainder.
expect_stdout_line_after(out: string, prefix: string,
                          want: string, msg: string) {
    lines = string.split(out, "\n")
    line_count = string.array_size(lines)
    found = 0
    actual = ""
    i = 0
    while i < line_count {
        line_ptr = string.array_get(lines, i)
        if string.starts_with(line_ptr, prefix) == 1 {
            plen = string.length(prefix)
            llen = string.length(line_ptr)
            // char_at_n over char_at: llen is already cached, so the
            // length-aware accessor skips the per-call strlen.
            // Skip leading whitespace immediately after the prefix.
            start = plen
            scanning_lead = 1
            while scanning_lead == 1 {
                if start >= llen {
                    scanning_lead = 0
                } else {
                    c = string.char_at_n(line_ptr, llen, start)
                    if c == 32 || c == 9 {
                        start = start + 1
                    } else {
                        scanning_lead = 0
                    }
                }
            }
            // Trim trailing whitespace.
            end = llen
            scanning_trail = 1
            while scanning_trail == 1 {
                if end <= start {
                    scanning_trail = 0
                } else {
                    c2 = string.char_at_n(line_ptr, llen, end - 1)
                    if c2 == 32 || c2 == 9 {
                        end = end - 1
                    } else {
                        scanning_trail = 0
                    }
                }
            }
            actual = string.substring(line_ptr, start, end)
            found = 1
            i = line_count
        } else {
            i = i + 1
        }
    }
    string.array_free(lines)
    if found == 0 {
        fail("${msg} — no line starts with '${prefix}'")
    } else {
        if string.equals(actual, want) == 0 {
            fail("${msg} — expected '${want}', got '${actual}'")
        }
    }
}

// expect_stdout_matches(out, pattern, msg) — at least one
// stdout line matches a glob pattern (`*`, `?`, `[abc]` per
// std.string.glob_match). Not regex — the porter spec asks for
// "basic" pattern matching, and stdlib has no PCRE today. For full
// regex needs, add a separate matcher after a regex extern lands.
// (Param `out`, not `stdout` — Windows MinGW reason.)
expect_stdout_matches(out: string, pattern: string, msg: string) {
    lines = string.split(out, "\n")
    line_count = string.array_size(lines)
    found = 0
    i = 0
    while i < line_count {
        line_ptr = string.array_get(lines, i)
        if string.glob_match_raw(pattern, line_ptr, 0) == 1 {
            found = 1
            i = line_count
        } else {
            i = i + 1
        }
    }
    string.array_free(lines)
    if found == 0 {
        fail("${msg} — no stdout line matches glob '${pattern}'")
    }
}

// expect_stdout_matches_regex(out, pattern, msg) — at least one
// stdout line matches a PCRE2 regular expression. The richer sibling
// of expect_stdout_matches (which is glob-only): full regex via
// std.regex — captures, anchors, alternation, character classes,
// quantifiers. The pattern is UNANCHORED, so it matches anywhere in a
// line (use `^`/`$` to anchor). Tested per-line, so `^Revision: \d+$`
// asserts a whole-line shape without the trailing-newline split issue.
//
// std.regex is built against libpcre2-8. If the runtime was built
// WITHOUT it, every regex entry point returns a clean diagnostic
// rather than crashing — matches_lit surfaces it in the error slot.
// We treat a non-empty error slot as a matcher failure (bad pattern OR
// missing libpcre2) and report it, so a missing-lib environment fails
// loudly instead of silently passing. Reach for expect_stdout_matches
// (glob) if you must run where libpcre2 may be absent.
expect_stdout_matches_regex(out: string, pattern: string, msg: string) {
    lines = string.split(out, "\n")
    line_count = string.array_size(lines)
    found = 0
    rerr = ""
    i = 0
    while i < line_count {
        line_ptr = string.array_get(lines, i)
        ok, err = regex.matches_lit(pattern, line_ptr)
        if string.equals(err, "") == 0 {
            // Compile/engine error (bad pattern or no libpcre2) — same
            // for every line, so capture once and stop.
            rerr = err
            i = line_count
        } else {
            if ok == 1 {
                found = 1
                i = line_count
            } else {
                i = i + 1
            }
        }
    }
    string.array_free(lines)
    if string.equals(rerr, "") == 0 {
        fail("${msg} — regex '${pattern}' error: ${rerr}")
    } else {
        if found == 0 {
            fail("${msg} — no stdout line matches regex '${pattern}'")
        }
    }
}

// ---------------------------------------------------------------------------
// Timing-budget matcher
//
// expect_elapsed_under(elapsed_ns, budget, msg) — a measured span
// is under a budget written as a Duration literal. The caller measures
// the span itself with two monotonic-clock reads:
//
//     t0 = os.now_monotonic_ns()
//     ... do work ...
//     elapsed = os.now_monotonic_ns() - t0
//     aeocha.expect_elapsed_under(elapsed, 50ms, "fast path")
//
// `elapsed_ns` is a plain int64 nanosecond count (what monotonic-ns
// deltas yield); `budget` is a Duration (`50ms`, `2s`, `200us`). We
// compare in ns via budget.ns — Duration-vs-plain-number is a type
// error in Aether, so the .ns accessor is the bridge. Use monotonic
// (not wall-clock) deltas: only the delta is meaningful and a wall
// jump would corrupt it.
//
// The budget renders directly via ${budget} (Duration interpolation
// picks the largest readable unit — `50ms`, `1.5s`); the elapsed side
// is a plain ns count, so we show it as ms.
expect_elapsed_under(elapsed_ns: long, budget: Duration, msg: string) {
    if elapsed_ns < budget.ns {
        // under budget — pass (no-op)
    } else {
        elapsed_ms = elapsed_ns / 1000000
        fail("${msg} — took ${elapsed_ms}ms, budget ${budget}")
    }
}

// expect_http_status(resp, want, msg) — response has the
// expected HTTP status code. Works for v1 (`http.get(url)`) and v2
// (`client.send_request(req)`) responses interchangeably.
expect_http_status(resp: ptr, want: int, msg: string) {
    if resp == 0 {
        fail("${msg} — null response")
    } else {
        actual = http.response_status(resp)
        if actual != want {
            fail("${msg} — expected status ${want}, got ${actual}")
        }
    }
}

// expect_http_no_error(resp, msg) — transport succeeded (DNS,
// connect, TLS, timeout all OK). Distinct from "200 OK" — non-2xx
// is not a transport error. Pair with expect_http_status to assert
// both layers.
expect_http_no_error(resp: ptr, msg: string) {
    if resp == 0 {
        fail("${msg} — null response")
    } else {
        err = http.response_error(resp)
        if string.equals(err, "") == 0 {
            fail("${msg} — transport error: '${err}'")
        }
    }
}

// expect_http_body_contains(resp, needle, msg) — substring of
// the response body. Binary-safe via the AetherString-aware
// string.contains; embedded NULs in `body` survive the boundary as
// long as the porter calls `client.response_body` (which preserves
// the header) rather than the C `http_response_body_str` accessor.
expect_http_body_contains(resp: ptr, needle: string, msg: string) {
    if resp == 0 {
        fail("${msg} — null response")
    } else {
        body = http.response_body(resp)
        if string.contains(body, needle) == 0 {
            fail("${msg} — body does not contain '${needle}'")
        }
    }
}

// expect_http_body_eq(resp, want, msg) — response body EXACTLY
// equals `want`. The exact-match sibling of expect_http_body_contains:
// reach for this when a substring match is too loose — e.g. a body of
// "5" must not satisfy a check that "50" would also pass. Binary-safe
// via string.equals (same AetherString-aware path as _contains), so a
// porter holding a resp already can assert exact bodies without a
// hand-rolled compare.
expect_http_body_eq(resp: ptr, want: string, msg: string) {
    if resp == 0 {
        fail("${msg} — null response")
    } else {
        body = http.response_body(resp)
        if string.equals(body, want) == 0 {
            fail("${msg} — body expected '${want}', got '${body}'")
        }
    }
}

// expect_http_header(resp, name, want, msg) — case-insensitive
// header equality. The header NAME is matched case-insensitively (per
// RFC 7230); the VALUE is compared exactly. Multiple values for the
// same header arrive joined with ", " from the stdlib accessor.
//
// Uses the std.http.client wrapper rather than binding the C extern
// directly: the wrapper snapshots the borrowed thread-local buffer via
// string.copy (closes upstream #269), so the returned value is owned
// and can't be clobbered by a later call. Binding the raw extern here
// would re-inherit that aliasing footgun.
expect_http_header(resp: ptr, name: string, want: string, msg: string) {
    if resp == 0 {
        fail("${msg} — null response")
    } else {
        actual = client.response_header(resp, name)
        if string.equals(actual, want) == 0 {
            fail("${msg} — header '${name}' expected '${want}', got '${actual}'")
        }
    }
}

// expect_http_body_json_field(resp, key, want, msg) —
// top-level JSON-string-field equality. Skips parsing libraries:
// the porter scope is "this top-level key has this string value".
// Looks for `"key":"want"` (with optional whitespace) inside the
// raw body. Sufficient for status / probe / smoke endpoints; reach
// for std.json directly when nesting or non-string values matter.
expect_http_body_json_field(resp: ptr, key: string,
                              want: string, msg: string) {
    if resp == 0 {
        fail("${msg} — null response")
    } else {
        body = http.response_body(resp)
        // Build the canonical "key":"want" needle. Doesn't tolerate
        // pretty-printed whitespace between `:` and the value — fine
        // for the porter's smoke-endpoint use case where the server
        // emits compact JSON. Document the constraint up here so the
        // failure message points at the right fix.
        needle = "\"${key}\":\"${want}\""
        if string.contains(body, needle) == 0 {
            fail("${msg} — JSON field '${key}' != '${want}' in body")
        }
    }
}

// ---------------------------------------------------------------------------
// High-level GET-and-assert matchers
//
// The low-level expect_http_* above all take a `resp` the caller must
// build and free. Every integration-test consumer ends up re-writing
// the same request / send_request / request_free / (assert) /
// response_free dance. These three matchers hide that lifecycle: each
// performs a GET, checks the transport, asserts, and frees the
// response — so a test asserts an HTTP response in one line.
//
// All three reuse the low-level matchers internally so the underlying
// semantics (status compare, exact/substring body) stay consistent.
//
// Lifecycle note: client.send_request already frees the response and
// returns null on a transport error (DNS/connect/TLS/timeout), so the
// `cerr != ""` branch must NOT call response_free — it would
// double-free. Only the success branch owns `resp`.
// ---------------------------------------------------------------------------

// _http_get_probe(url, want_status, kind, want) — do ONE GET and return
// 1 if it matched, 0 otherwise. Never calls fail; frees the response
// itself. The silent predicate the retry driver polls. `kind`: 0 =
// status only; 1 = status 200 + body == want; 2 = status 200 + body
// contains want. (For kind 0, want_status is the target; for 1/2 it's
// always 200 and `want` carries the body expectation.)
_http_get_probe(url: string, want_status: int, kind: int, want: string) -> int {
    req = client.request("GET", url)
    resp, cerr = client.send_request(req)
    client.request_free(req)
    if string.equals(cerr, "") == 0 {
        return 0
    }
    matched = 0
    if kind == 0 {
        if http.response_status(resp) == want_status { matched = 1 }
    } else {
        if http.response_status(resp) == 200 {
            body = http.response_body(resp)
            if kind == 1 {
                if string.equals(body, want) == 1 { matched = 1 }
            } else {
                if string.contains(body, want) == 1 { matched = 1 }
            }
        }
    }
    client.response_free(resp)
    return matched
}

// _http_get_retry(url, want_status, kind, want) — honour an ambient
// within()/without() budget by polling _http_get_probe until the
// condition holds (within) or stops holding (without), or the budget
// elapses. Returns the final probe verdict the matcher reports on. When
// no budget is set this is a single probe — identical to the old
// one-shot behaviour. Consumes the budget (one-shot modifier).
_http_get_retry(url: string, want_status: int, kind: int, want: string) -> int {
    // Snapshot poll/without BEFORE _take_retry_budget (which resets them).
    poll = retry_poll_ns
    without = retry_without
    budget = _take_retry_budget()
    if budget == 0 {
        return _http_get_probe(url, want_status, kind, want)
    }
    deadline = os.now_monotonic_ns() + budget
    // For within: succeed as soon as probe==1. For without: succeed as
    // soon as probe==0 (condition gone). `target` is the probe value
    // that means "done, satisfied".
    target = 1
    if without == 1 { target = 0 }
    last = _http_get_probe(url, want_status, kind, want)
    done = 0
    if last == target { done = 1 }
    while done == 0 {
        if os.now_monotonic_ns() >= deadline {
            done = 1
        } else {
            sleep(poll / 1000000)
            last = _http_get_probe(url, want_status, kind, want)
            if last == target { done = 1 }
        }
    }
    // Report whether the satisfied condition was reached.
    if last == target { return 1 }
    return 0
}

// expect_http_get_status(url, want_status, msg) — GET url, assert
// the transport succeeded and the status equals want_status. Use this
// for non-200 expectations (404, 500, redirects) where the body is not
// the point. Honours a preceding within(budget)/without(budget): the
// GET is retried until the status matches (within) or stops matching
// (without), or the budget elapses.
expect_http_get_status(url: string, want_status: int, msg: string) {
    ok = _http_get_retry(url, want_status, 0, "")
    if ok == 0 {
        fail("${msg} — GET ${url} did not reach status ${want_status}")
    }
}

// expect_http_get_body_eq(url, want, msg) — GET url, assert
// transport ok + status 200 + body EXACTLY equals want. Prefer this
// over _contains when the result must match exactly (e.g. GET
// /add/2/3 returning "5" — "50" must not pass). Honours within/without.
expect_http_get_body_eq(url: string, want: string, msg: string) {
    ok = _http_get_retry(url, 200, 1, want)
    if ok == 0 {
        fail("${msg} — GET ${url} body never equalled '${want}' (200)")
    }
}

// expect_http_get_body_contains(url, needle, msg) — GET url,
// assert transport ok + status 200 + body contains needle. The
// substring twin of expect_http_get_body_eq — use when the body is a
// larger document and only a marker matters. Honours within/without.
expect_http_get_body_contains(url: string, needle: string, msg: string) {
    ok = _http_get_retry(url, 200, 2, needle)
    if ok == 0 {
        fail("${msg} — GET ${url} body never contained '${needle}' (200)")
    }
}

// eventually(pred, msg) — the generic poll-until form of the floating
// modifier. `pred` is a zero-arg function returning 1 (condition holds)
// or 0. Under a preceding within(budget) it polls pred until it returns
// 1 (or the budget elapses); under without(budget) it polls until pred
// returns 0. With no budget it evaluates pred ONCE — same "no within,
// no waiting" contract as the GET matchers. Fails if the target wasn't
// reached.
//
//   within(5s)
//   aeocha.eventually(server_is_up, "server came up")
//
// `pred` is typically a top-level function passed by bare name; that
// works from inside an it() closure and across the import boundary
// since aether #940 / #943 landed.
eventually(pred: fn, msg: string) {
    // Snapshot poll/without BEFORE _take_retry_budget (which resets them).
    without = retry_without
    poll = retry_poll_ns
    budget = _take_retry_budget()
    // Target probe value meaning "satisfied": 1 for within, 0 for without.
    target = 1
    if without == 1 { target = 0 }

    last = 0
    if call(pred) == 1 { last = 1 }
    done = 0
    if last == target { done = 1 }
    if budget == 0 {
        // No within()/without(): single evaluation, no waiting.
        done = 1
    }
    if done == 0 {
        deadline = os.now_monotonic_ns() + budget
        while done == 0 {
            if os.now_monotonic_ns() >= deadline {
                done = 1
            } else {
                sleep(poll / 1000000)
                last = 0
                if call(pred) == 1 { last = 1 }
                if last == target { done = 1 }
            }
        }
    }
    if last != target {
        if without == 1 {
            fail("${msg} — condition still held after budget")
        } else {
            fail("${msg} — condition not met within budget")
        }
    }
}

// ---------------------------------------------------------------------------
// Fluent assertion facade — subject-first, chainable
//
// The flat assert_*/expect_* matchers above are the primitive layer and
// stay as-is. This facade is sugar on top, for tests that prefer the
// Fowler-style fluent grammar the BDD community popularised:
//
//     aeocha.expect_int(count).to_equal(5).to_be_gt(0)
//     aeocha.expect_str(name).to_contain("foo")
//     aeocha.expect_int(x).not_().to_equal(5)
//
// How it works:
//   - expect_int(v) / expect_str(v) return a small by-value subject
//     record (the value + a negated flag).
//   - each .to_* is a free function whose first parameter is the
//     subject, so UFCS (aether #934) lets it be called as a method and
//     return the subject again — that's the chain.
//   - failures are reported via fail() against the AMBIENT framework
//     (current_fw, set by init()), so the chain carries no `fw`. This
//     relies on module-var state crossing the import boundary (#937).
//   - not_() flips the next matcher's sense by returning a negated copy.
//
// Requires ae 0.328+ (both #934 and #937 fixed). Naming mirrors the
// flat layer's int/string split (assert_eq vs assert_str_eq): int
// matchers are unsuffixed, string matchers carry a distinguishing name.
// Aether has no receiver-type overloading, so a single `to_equal` can't
// serve both int and string subjects — expect_str uses to_equal_str.
//
// Single-framework caveat: the facade reads current_fw, so it asserts
// against whichever framework init()'d last. Fine for the normal
// one-framework-per-process test; the flat matchers remain the way to
// drive two frameworks at once.
// ---------------------------------------------------------------------------

struct IntSubject { value: int, negated: int }
struct StrSubject { value: string, negated: int }

expect_int(v: int) -> IntSubject { return IntSubject { value: v, negated: 0 } }
expect_str(v: string) -> StrSubject { return StrSubject { value: v, negated: 0 } }

// not_() — flip the sense of the NEXT matcher in the chain.
not_(s: IntSubject) -> IntSubject {
    return IntSubject { value: s.value, negated: 1 }
}

// _verdict_int(ok) — shared verdict: given whether the positive
// predicate held, report against the ambient fw honouring the negated
// flag.
_verdict_int(s: IntSubject, ok: int, what: string) {
    if s.negated == 0 {
        if ok == 0 { fail("expected ${what}") }
    } else {
        if ok == 1 { fail("expected NOT ${what}") }
    }
}

to_equal(s: IntSubject, want: int) -> IntSubject {
    ok = 0
    if s.value == want { ok = 1 }
    _verdict_int(s, ok, "${want}, got ${s.value}")
    return s
}

to_be_gt(s: IntSubject, bound: int) -> IntSubject {
    ok = 0
    if s.value > bound { ok = 1 }
    _verdict_int(s, ok, "> ${bound}, got ${s.value}")
    return s
}

to_be_lt(s: IntSubject, bound: int) -> IntSubject {
    ok = 0
    if s.value < bound { ok = 1 }
    _verdict_int(s, ok, "< ${bound}, got ${s.value}")
    return s
}

to_be_truthy(s: IntSubject) -> IntSubject {
    ok = 0
    if s.value != 0 { ok = 1 }
    _verdict_int(s, ok, "truthy, got ${s.value}")
    return s
}

to_be_falsy(s: IntSubject) -> IntSubject {
    ok = 0
    if s.value == 0 { ok = 1 }
    _verdict_int(s, ok, "falsy, got ${s.value}")
    return s
}

// String subject matchers. negated is honoured but there's no string
// not_() yet — add one if a downstream test needs `.not_().to_contain`.
to_equal_str(s: StrSubject, want: string) -> StrSubject {
    if string.equals(s.value, want) == 0 {
        fail("expected '${want}', got '${s.value}'")
    }
    return s
}

to_contain(s: StrSubject, needle: string) -> StrSubject {
    if string.contains(s.value, needle) == 0 {
        fail("'${s.value}' does not contain '${needle}'")
    }
    return s
}

to_start_with(s: StrSubject, prefix: string) -> StrSubject {
    if string.starts_with(s.value, prefix) == 0 {
        fail("'${s.value}' does not start with '${prefix}'")
    }
    return s
}

// satisfies(s, pred, msg) — fluent escape hatch (AssertJ-style). `pred`
// takes the subject's value and returns 1 (ok) / 0 (fail). Lets a test
// drop into an arbitrary one-off check mid-chain without defining a
// whole new matcher:
//   aeocha.expect_int(n).to_be_gt(0).satisfies(is_prime, "is prime")
// `pred` is a top-level fn passed by bare name (works in closures /
// across modules since aether #940/#943). One satisfies() per subject
// type — Aether has no receiver-type overloading.
satisfies(s: IntSubject, pred: fn, msg: string) -> IntSubject {
    ok = 0
    if call(pred, s.value) == 1 { ok = 1 }
    _verdict_int(s, ok, "to satisfy '${msg}', got ${s.value}")
    return s
}

satisfies_str(s: StrSubject, pred: fn, msg: string) -> StrSubject {
    if call(pred, s.value) == 0 {
        fail("'${s.value}' did not satisfy '${msg}'")
    }
    return s
}

// ---------------------------------------------------------------------------
// Collection matchers (flat). Operate on a std.list of strings — the
// common shape in tests (captured lines, names, ids). Tier-1 style:
// plain functions that report via fail(), exactly like a user's own
// custom matcher. Int lists are deliberately omitted (the raw list
// stores pointers; an int-list convention would need boxing) — assert
// on a string projection, or write a one-off matcher.
// ---------------------------------------------------------------------------

// expect_list_size(xs, want, msg) — the list has exactly `want` items.
expect_list_size(xs: ptr, want: int, msg: string) {
    n = list.size(xs)
    if n != want {
        fail("${msg} — expected ${want} items, got ${n}")
    }
}

// expect_list_empty(xs, msg) — the list has no items.
expect_list_empty(xs: ptr, msg: string) {
    n = list.size(xs)
    if n != 0 {
        fail("${msg} — expected empty list, got ${n} items")
    }
}

// expect_list_has_str(xs, needle, msg) — some element equals `needle`
// (exact string match).
expect_list_has_str(xs: ptr, needle: string, msg: string) {
    n = list.size(xs)
    found = 0
    i = 0
    while i < n {
        item = list.get_raw(xs, i)
        if string.equals(item, needle) == 1 {
            found = 1
            i = n
        } else {
            i = i + 1
        }
    }
    if found == 0 {
        fail("${msg} — list has no element equal to '${needle}'")
    }
}

// ---------------------------------------------------------------------------
// Runner — print summary, exit(1) if anything failed
// ---------------------------------------------------------------------------

run_summary(fw: ptr) {
    passed_ref = map_get_raw(fw, "passed")
    failed_ref = map_get_raw(fw, "failed")
    depth_ref = map_get_raw(fw, "depth")
    passed = ref_get(passed_ref)
    failed = ref_get(failed_ref)

    println("")
    if failed == 0 {
        println("\x1b[32m  ${passed} passing\x1b[0m")
    } else {
        println("\x1b[32m  ${passed} passing\x1b[0m")
        println("\x1b[31m  ${failed} failing\x1b[0m")
    }
    println("")

    // Structured per-it report — only emitted when invoked under
    // a parent that opened a back-channel (e.g. aeb's
    // driver_test). When `ae run foo.ae` from a terminal, the
    // channel is -1 and this block is skipped — no behavior
    // change for existing consumers.
    //
    // Format pinned at version=1: header KV block + "---\n"
    // separator + tab-packed per-it rows. See
    // aeocha-aeb-ipc-reporting.md for the full spec.
    ch = ipc.parent_channel()
    if ch >= 0 {
        report = _format_aeb_report(fw, passed, failed)
        // ae_fd_write + ae_fd_close mirror std.ipc.write_close
        // semantics. Inline-extern'd at the top of this file.
        net.fd_write(ch, report)
        net.fd_close(ch)
    }

    ref_free(passed_ref)
    ref_free(failed_ref)
    ref_free(depth_ref)

    if failed > 0 {
        exit(1)
    }
}

// Build the structured report payload for the aeb back-channel.
// Format (version=1, ns-precision rows since 4e):
//
//   version=1
//   total=N
//   passed=N
//   failed=N
//   errored=N
//   duration_ms=N        (retained for v1 readers; may round to 0)
//   duration_ns=N        (added: full-precision total)
//   ---
//   PASS\t<index>\t"<name>"\t<duration_ns>\n
//   FAIL\t<index>\t"<name>"\t<duration_ns>\t<failure_message>\n
//   ...
//
// The per-row duration is nanoseconds (was ms) so sub-ms tests don't
// all report 0; v1 row consumers match STATUS/index/"name"/message
// and ignore the duration value, so this is wire-compatible.
//
// Self-truncates if the formatted report exceeds ~60K to avoid
// pipe-buffer deadlock on Linux's 64K default. Drops
// failure_messages first; if still over budget, drops per-row
// durations; in the worst case the parent gets just the header.
//
// errored is always 0 in v1 — Aeocha categorises everything as
// PASS or FAIL today. Reserved in the schema for future
// enrichment (assertion threw, before_each crashed, etc.).
_format_aeb_report(fw: ptr, passed: int, failed: int) -> string {
    its = map.get_raw(fw, "its")
    n = list.size(its)
    t_start_str = map.get_raw(fw, "t_start_ns_str")
    t_start_ns = string.get_long(t_start_str)
    // Monotonic end to match the monotonic start stamped in init() —
    // mixing the two clocks would yield a garbage delta.
    total_duration_ns = os.now_monotonic_ns() - t_start_ns
    total_duration_ms = total_duration_ns / 1000000

    // Header KV block. Numbers fold via string interpolation —
    // ${x} is the same path the existing aeocha print() calls
    // already use, so no extra extern needed.
    //
    // Wire compatibility: version stays 1 and duration_ms is retained
    // so existing v1 parsers keep working. duration_ns is ADDED for
    // full precision (4e) — a fast run that rounds to duration_ms=0
    // still reports real nanoseconds. v1 readers ignore the extra key.
    total = passed + failed
    header = "version=1\ntotal=${total}\npassed=${passed}\nfailed=${failed}\nerrored=0\nduration_ms=${total_duration_ms}\nduration_ns=${total_duration_ns}\n---\n"

    // Per-it rows. Try with full detail first; if oversized,
    // drop failure_messages; if still oversized, drop durations.
    // Budget: 60K leaves ~4K headroom under Linux's 64K pipe.
    rows_full = _build_rows(its, n, 1, 1)
    rep_full = string.concat(header, rows_full)
    if string.length(rep_full) <= 60000 {
        return rep_full
    }
    rows_no_msg = _build_rows(its, n, 0, 1)
    rep_no_msg = string.concat(header, rows_no_msg)
    if string.length(rep_no_msg) <= 60000 {
        return rep_no_msg
    }
    rows_minimal = _build_rows(its, n, 0, 0)
    rep_minimal = string.concat(header, rows_minimal)
    if string.length(rep_minimal) <= 60000 {
        return rep_minimal
    }
    // Worst case: header only. Parent still sees a valid v1 report,
    // just with zero per-it detail.
    return header
}

// Build the per-it rows, optionally including the
// failure_message (if any) and duration_ms columns. Used by
// _format_aeb_report's progressive truncation.
//
// Built through std.strbuilder rather than a `string.concat`
// accumulator: a suite with many `it`s would otherwise pay an
// O(N²) realloc-and-memcpy of the whole prefix on every row.
_build_rows(its: ptr, n: int, with_msg: int, with_dur: int) -> string {
    b = strbuilder.new(1024)
    i = 0
    while i < n {
        it_rec = list.get_raw(its, i)
        status = map.get_raw(it_rec, "status")
        name = map.get_raw(it_rec, "name")
        idx = i + 1

        // Base row: STATUS\tindex\t"name"  (\t=9, "=34)
        strbuilder.append(b, status)
        strbuilder.append_byte(b, 9)
        strbuilder.append_int(b, idx)
        strbuilder.append_byte(b, 9)
        strbuilder.append_byte(b, 34)
        strbuilder.append(b, name)
        strbuilder.append_byte(b, 34)

        if with_dur != 0 {
            // Per-row duration is now nanoseconds (4e): full precision,
            // so sub-ms tests don't all report 0. The v1 row consumer
            // matches on STATUS/index/"name"/message and does not parse
            // the duration value, so widening ms->ns is wire-safe.
            dur_str = map.get_raw(it_rec, "duration_ns_str")
            strbuilder.append_byte(b, 9)
            strbuilder.append(b, dur_str)
        }

        if with_msg != 0 {
            if map.has(it_rec, "failure_message") == 1 {
                msg = map.get_raw(it_rec, "failure_message")
                strbuilder.append_byte(b, 9)
                // Cap individual messages at 256 chars to keep any
                // single row bounded.
                if string.length(msg) > 256 {
                    strbuilder.append(b, string.substring(msg, 0, 256))
                } else {
                    strbuilder.append(b, msg)
                }
            }
        }

        strbuilder.append_byte(b, 10)
        i = i + 1
    }
    return strbuilder.finish(b)
}
