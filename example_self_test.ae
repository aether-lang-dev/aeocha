// Aeocha self-test — validates the test framework itself, by
// importing it as a module (no inlined framework code, as in the
// pre-rewrite version). Closes TODO items (1) and (2) end-to-end:
// `import aeocha` works, the framework is reached via
// `aeocha.X` namespaced calls, and the bare `after` is gone (only
// `after_each` remains).
//
// Run with:
//   ae run aeocha/example_self_test.ae
//
// Expected: all green, exit 0.
//
// Call shape: aeocha follows Aether's _ctx auto-injection convention
// (see docs/closures-and-builder-dsl.md). The TOP-level call to
// `aeocha.describe(fw, ...)` passes `fw` explicitly because there's
// no enclosing trailing block to auto-inject from. Nested
// `aeocha.describe`, `aeocha.it`, `aeocha.before_each`, and
// `aeocha.after_each` calls omit the first arg — Aether auto-injects
// the surrounding describe's suite context as `_ctx`. Matchers
// (`assert_*` / `expect_*`) take NO `fw` (3a): they report against the
// ambient framework `init()` set, so an `it()` callback just calls
// `aeocha.assert_eq(a, b, msg)`. Only `describe`(top-level) and
// `run_summary` still take `fw`.

import aeocha
import std.string

main() {
    fw = aeocha.init()

    // Shared state for the before_each test below — declared in
    // main()'s scope so closures capture it by ref-ptr cleanly.
    hook_counter = ref(0)

    aeocha.describe(fw, "Aeocha framework") {

        aeocha.describe("assertions") {
            aeocha.it("assert_eq passes on equal values") callback {
                aeocha.assert_eq(42, 42, "42 == 42")
            }

            aeocha.it("assert_true passes on truthy") callback {
                aeocha.assert_true(1, "1 is truthy")
            }

            aeocha.it("assert_false passes on falsy") callback {
                aeocha.assert_false(0, "0 is falsy")
            }

            aeocha.it("assert_str_eq works") callback {
                aeocha.assert_str_eq("hello", "hello", "string equality")
            }

            aeocha.it("assert_contains works") callback {
                aeocha.assert_contains("hello world", "world", "contains")
            }

            aeocha.it("assert_not_eq works") callback {
                aeocha.assert_not_eq(1, 2, "1 != 2")
            }

            aeocha.it("assert_gt works") callback {
                aeocha.assert_gt(10, 5, "10 > 5")
            }

            aeocha.it("assert_null works") callback {
                aeocha.assert_null(null, "null is null")
            }

            aeocha.it("assert_not_null works") callback {
                aeocha.assert_not_null(fw, "fw is not null")
            }
        }

        aeocha.describe("fluent assertions") {
            // Subject-first, chainable facade. No `fw` in the chain —
            // the matchers read the ambient framework set by init().
            aeocha.it("chains int matchers") callback {
                aeocha.expect_int(5).to_equal(5).to_be_gt(0).to_be_lt(10)
            }

            aeocha.it("supports not_() negation") callback {
                aeocha.expect_int(5).not_().to_equal(6)
            }

            aeocha.it("int truthiness matchers") callback {
                aeocha.expect_int(1).to_be_truthy()
                aeocha.expect_int(0).to_be_falsy()
            }

            aeocha.it("chains string matchers") callback {
                aeocha.expect_str("hello world").to_equal_str("hello world").to_contain("world").to_start_with("hello")
            }
        }

        aeocha.describe("before/after_each hooks") {
            aeocha.before_each() callback {
                ref_set(hook_counter, ref_get(hook_counter) + 1)
            }

            aeocha.it("first test sees counter at 1") callback {
                aeocha.assert_eq(ref_get(hook_counter), 1, "after one before_each")
            }

            aeocha.it("second test sees counter at 2") callback {
                aeocha.assert_eq(ref_get(hook_counter), 2, "after two before_each")
            }
        }

        aeocha.describe("nested describes") {
            aeocha.describe("level 2") {
                aeocha.it("works at depth 2") callback {
                    aeocha.assert_true(1, "depth 2 case")
                }

                aeocha.describe("level 3") {
                    aeocha.it("works at depth 3") callback {
                        aeocha.assert_true(1, "depth 3 case")
                    }
                }
            }
        }
    }

    aeocha.run_summary(fw)
}
